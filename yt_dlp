#!/data/data/com.termux/files/usr/bin/bash

# Run app.py from whatever directory this launcher lives in,
# so it works both locally and from a fresh clone.
APP_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SCRIPT_NAME="app.py"

cd "$APP_DIR" || exit
python "$SCRIPT_NAME"

